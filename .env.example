# Server-only. Never prefix this variable with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_FAST_MODEL=gpt-5.6-terra

# Required outside development. Use a random value of at least 32 bytes.
SESSION_SECRET=

# Local synthetic pilot data only. The directory is ignored by Git.
DATA_DB_PATH=./data/trust-to-action-v2.2.sqlite

# Required for 2.2 knowledge-enhanced generation. Mount the private pack read-only.
# The directory must contain the four selected SKILLS and five final Markdown sources.
KNOWLEDGE_PACK_PATH=

# Default enterprise-pilot boundary. Use mock only for isolated UI tests.
VITE_DATA_MODE=http
