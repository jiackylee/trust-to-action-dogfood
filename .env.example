# Server-only. Never prefix this variable with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_FAST_MODEL=gpt-5.6-terra
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-max

# Real provider tests are opt-in, one provider at a time.
# RUN_LIVE_OPENAI_TEST=1 npm run test:live
# RUN_LIVE_DEEPSEEK_TEST=1 npm run test:live
# RUN_LIVE_ANTHROPIC_TEST=1 npm run test:live
# RUN_LIVE_QWEN_TEST=1 npm run test:live

# Comma-separated hostnames for enterprise private endpoints. Never include URL paths.
AI_ENDPOINT_ALLOWLIST=

# Private CA certificates must be supplied before Node starts, for example:
# NODE_EXTRA_CA_CERTS=/absolute/path/to/enterprise-ca.pem npm run dev

# Required outside development. Use a random value of at least 32 bytes.
SESSION_SECRET=

# Local synthetic pilot data only. The directory is ignored by Git.
DATA_DB_PATH=./data/trust-to-action-v2.3.sqlite

# Required for knowledge-enhanced generation. Mount the private pack read-only.
# The directory must contain the four selected SKILLS and five final Markdown sources.
KNOWLEDGE_PACK_PATH=

# Default enterprise-pilot boundary. Use mock only for isolated UI tests.
VITE_DATA_MODE=http
