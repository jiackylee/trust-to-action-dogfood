{
  "name": "trust-to-action-dogfood-v2",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1 --port 4174",
    "dev:server": "PORT=4175 tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "PORT=4174 SERVE_DIST=true tsx server/index.ts",
    "test": "vitest run",
