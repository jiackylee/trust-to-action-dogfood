    "test:e2e": "playwright test",
    "test:live": "vitest run server/live-providers.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "better-sqlite3": "^13.0.3",
    "express": "5.2.1",
